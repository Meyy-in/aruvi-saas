# Aruvi local secrets — copy to `.env` and fill in. `.env` is gitignored; this file
# is the committed template and must never hold a real value.
#
#   cp .env.example .env
#   chmod 600 .env
#   ./dev.sh
#
# api/main.py reads these ONCE at startup: with all three of HOST/USER/PASSWORD set it
# installs SmtpNotifier and mail really sends; with any of them missing it installs
# FileNotifier and writes to data/cloud/state/outbox/ instead. `./dev.sh` and
# `./dev.sh status` both say which, out loud.

# ── outbound mail ──────────────────────────────────────────────────────────────
ARUVI_SMTP_HOST=smtp.gmail.com
ARUVI_SMTP_PORT=587

# The Workspace user that AUTHENTICATES. Must be a real user, not an alias —
# aliases cannot hold app passwords.
ARUVI_SMTP_USER=support@meyy.in

# A Google APP PASSWORD (myaccount.google.com/apppasswords, signed in AS the user
# above, with 2-Step Verification on). Never the account password.
#
# ⚠ KEEP THE QUOTES. dev.sh sources this file with the shell, so an unquoted value
#   containing the spaces Google displays ("abcd efgh ijkl mnop") makes the shell run
#   each word as a command — "efgh: command not found", and mail silently stays off.
#   Quoted is safest; pasting the 16 characters with no spaces also works.
ARUVI_SMTP_PASSWORD='xxxx xxxx xxxx xxxx'

# The address mail is SENT from, and the one replies go to. Keep it equal to
# ARUVI_SMTP_USER unless you have set up a verified "Send mail as" alias — Gmail
# rewrites a From the authenticated account does not own.
ARUVI_MAIL_FROM=support@meyy.in
ARUVI_SUPPORT_ADDRESS=support@meyy.in

# ── optional ───────────────────────────────────────────────────────────────────
# ARUVI_MAIL_BCC_FOUNDER=1
# ARUVI_TODAY=2026-09-04          # simulate a date; malformed values are non-fatal

# ── identity (Track B, 2026-09-09) ─────────────────────────────────────────────
# header   = the X-Aruvi-User dev stub (no Supabase needed)
# supabase = the request must carry a Supabase access token; the web needs
#            web/.env.local (NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY) for the same project.
ARUVI_AUTH_PROVIDER=supabase
ARUVI_SUPABASE_URL=https://npgqolatfnpvxaehdjiu.supabase.co
# ARUVI_SUPABASE_JWT_SECRET=   # only for a project still signing with the legacy HS256 secret

# ── Bucket B backend (Track C, 2026-09-09) ────────────────────────────────────
# file     = data/cloud/state/ (default) · postgres = Supabase (one `documents` table)
# Local dev stays on files; set these two to run the local API against Supabase.
# ARUVI_STATE_BACKEND=postgres
# ARUVI_DATABASE_URL=postgresql://postgres.<ref>:<db password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── WhatsApp Cloud API (2026-09-26) — leave empty to keep sends in state/whatsapp_outbox/.
# Token: a SYSTEM-USER token from Meta Business Settings (not the 24h test token).
# Phone number id: WhatsApp Manager › API setup (an id, NOT 9363795723).
# Verify token: any string; type the same into the Meta app's webhook config.
# App secret: Meta app › Settings › Basic. Template must be APPROVED, one body var {{1}} = first name.
ARUVI_WA_TOKEN=
ARUVI_WA_PHONE_NUMBER_ID=
ARUVI_WA_VERIFY_TOKEN=
ARUVI_WA_APP_SECRET=
# ARUVI_WA_WELCOME_TEMPLATE=meyy_welcome
# ARUVI_WA_TEMPLATE_LANG=en
